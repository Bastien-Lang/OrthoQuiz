{
 "id": "a_a",
 "title": "a / à",
 "subtitle": "Verbe avoir ou préposition ?",
 "version": 1,
 "order": 10,
 "rule": "« a » est le verbe avoir : on peut le remplacer par « avait ». « à » est une préposition : on ne peut pas dire « avait » à sa place.",
 "questions": [
  {"lvl":1,"q":"Léa ___ un chat noir.","choices":["a","à"],"answer":"a","why":"Léa avait un chat noir : on peut remplacer par « avait »."},
  {"lvl":1,"q":"Nous allons ___ l'école.","choices":["a","à"],"answer":"à"},
  {"lvl":1,"q":"Mon frère ___ dix ans.","choices":["a","à"],"answer":"a"},
  {"lvl":1,"q":"Je donne un livre ___ Paul.","choices":["a","à"],"answer":"à"},
  {"lvl":1,"q":"Elle ___ faim.","choices":["a","à"],"answer":"a"},
  {"lvl":1,"q":"Samedi, je vais ___ la piscine.","choices":["a","à"],"answer":"à"},
  {"lvl":1,"q":"Le chat ___ mangé sa pâtée.","choices":["a","à"],"answer":"a"},
  {"lvl":1,"q":"Il pleut ___ verse.","choices":["a","à"],"answer":"à","why":"« à verse » est une expression : on ne peut pas dire « avait verse »."},
  {"lvl":2,"q":"Il ___ plu toute la nuit.","choices":["a","à"],"answer":"a"},
  {"lvl":2,"q":"Ce stylo est ___ moi.","choices":["a","à"],"answer":"à"},
  {"lvl":2,"q":"Camille est partie ___ Paris.","choices":["a","à"],"answer":"à"},
  {"lvl":2,"q":"Qui ___ pris mon cahier ?","choices":["a","à"],"answer":"a"},
  {"lvl":2,"q":"Il ne ___ pas voulu venir.","choices":["a","à"],"answer":"a"},
  {"lvl":2,"q":"Ce livre est facile ___ lire.","choices":["a","à"],"answer":"à"},
  {"lvl":2,"q":"Elle s'est mise ___ chanter.","choices":["a","à"],"answer":"à"},
  {"lvl":2,"q":"Mon voisin ___ une belle voiture.","choices":["a","à"],"answer":"a"},
  {"lvl":3,"q":"Où ___-t-il garé sa voiture ?","choices":["a","à"],"answer":"a","why":"Où avait-il garé sa voiture ? : le verbe avoir est inversé avec le sujet."},
  {"lvl":3,"q":"Il est ___ la recherche d'un emploi.","choices":["a","à"],"answer":"à"},
  {"lvl":3,"q":"Elle ___ pris le train de huit heures.","choices":["a","à"],"answer":"a"},
  {"lvl":3,"q":"Le professeur a expliqué la règle ___ ses élèves.","choices":["a","à"],"answer":"à"},
  {"lvl":3,"q":"Il n'y ___ plus de pain.","choices":["a","à"],"answer":"a","why":"Il n'y avait plus de pain : « il y a » est le verbe avoir."},
  {"lvl":3,"q":"Elle apprend ___ nager.","choices":["a","à"],"answer":"à"},
  {"lvl":3,"q":"Tout le monde ___ le droit de s'exprimer.","choices":["a","à"],"answer":"a"},
  {"lvl":3,"q":"Il est resté ___ la maison toute la journée.","choices":["a","à"],"answer":"à"}
 ]
}
